        :root {
            --bg-color: #f4f7f6;
            --container-bg: #ffffff;
            --text-color: #333333;
            --card-bg: #fafafa;
            --border-color: #e0e0e0;
            --primary-color: #2c3e50;
            --accent-color: #3498db;
            --hover-bg: #ebf5fb;
            --shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        [data-theme="dark"] {
            --bg-color: #121212;
            --container-bg: #1e1e1e;
